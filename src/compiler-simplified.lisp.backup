;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; VERSIONS SIMPLIFIÉES DES FONCTIONS NON COMPILABLES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Ce fichier contient des versions simplifiées des fonctions
;;; du compilateur qui utilisent uniquement des constructions
;;; compilables par le bootstrap COND + IDs.
;;;
;;; TRANSFORMATIONS APPLIQUÉES:
;;;   - SETF → SETQ ou fonctions SET-XXX
;;;   - CAR/CDR → Paramètres séparés ou accès direct
;;;   - Labels symboliques → Strings
;;;   - EQ/LISTP/etc → Tests alternatifs
;;;   - LOOP WHILE → Récursion
;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(format t "~%Chargement des versions simplifiées...~%")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 1. GEN-LABEL - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; ORIGINAL (non compilable):
;; (defun gen-label (base)
;;   (let ((counter '(0)))
;;     (setq (car counter) (+ (car counter) 1))
;;     (format nil "~A_~A" base (car counter))))
;;
;; PROBLÈME: (SETQ (CAR counter) ...) non supporté
;;

(defvar *label-counter* 0)

(defun gen-label-simplified (base)
  "Génère un label unique - version simplifiée sans CAR/CDR"
  (setq *label-counter* (+ *label-counter* 1))
  (format nil "~A_~A" base *label-counter*))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 2. COMPILE-IF - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; ORIGINAL (non compilable):
;; Utilise (gen-label 'ELSE) et (gen-label 'END)
;;
;; PROBLÈME: Labels symboliques 'ELSE au lieu de "ELSE"
;;

(defun compile-if-simplified (condition then-branch else-branch env)
  "Compile (IF cond then else) - version avec strings pour labels"
  (let ((else-label (gen-label-simplified "ELSE"))
        (end-label (gen-label-simplified "END")))
    (append
     ;; Compiler la condition
     (compile-expr-with-ids condition env)
     ;; Si faux, sauter vers ELSE
     (list (list :BEQ *reg-v0* *reg-zero* else-label))
     ;; Compiler la branche THEN
     (compile-expr-with-ids then-branch env)
     (list (list :J end-label))
     ;; Label ELSE
     (list (list :LABEL else-label))
     ;; Compiler la branche ELSE
     (if else-branch
         (compile-expr-with-ids else-branch env)
         (list (list :LI *reg-v0* 0)))
     ;; Label END
     (list (list :LABEL end-label)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 3. COMPILE-COND - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-cond-simplified (clauses env)
  "Compile (COND ...) - version avec strings"
  (if (null clauses)
      ;; Pas de clauses : retourner NIL
      (list (list :LI *reg-v0* 0))
      ;; Compiler récursivement
      (let* ((clause (first clauses))
             (test-expr (first clause))
             (body-exprs (rest clause))
             (next-label (gen-label-simplified "COND_NEXT"))
             (end-label (gen-label-simplified "COND_END")))
        (append
         ;; Compiler le test
         (compile-expr-with-ids test-expr env)
         ;; Si faux, essayer la clause suivante
         (list (list :BEQ *reg-v0* *reg-zero* next-label))
         ;; Compiler le corps
         (if body-exprs
             (compile-progn-simplified body-exprs env)
             (list (list :LI *reg-v0* 1)))  ; T si pas de corps
         (list (list :J end-label))
         ;; Label pour clause suivante
         (list (list :LABEL next-label))
         ;; Compiler les clauses restantes
         (compile-cond-simplified (rest clauses) env)
         ;; Label de fin
         (list (list :LABEL end-label))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 4. COMPILE-PROGN - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-progn-simplified (exprs env)
  "Compile (PROGN ...) - version simplifiée"
  (if (null exprs)
      (list (list :LI *reg-v0* 0))
      (if (null (rest exprs))
          ;; Dernière expression
          (compile-expr-with-ids (first exprs) env)
          ;; Compiler l'expression, ignorer résultat, continuer
          (append
           (compile-expr-with-ids (first exprs) env)
           (compile-progn-simplified (rest exprs) env)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 5. COMPILE-WHEN - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-when-simplified (condition body env)
  "Compile (WHEN cond body...) - version avec strings"
  (let ((end-label (gen-label-simplified "WHEN_END")))
    (append
     (compile-expr-with-ids condition env)
     (list (list :BEQ *reg-v0* *reg-zero* end-label))
     (compile-progn-simplified body env)
     (list (list :LABEL end-label)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 6. COMPILE-UNLESS - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-unless-simplified (condition body env)
  "Compile (UNLESS cond body...) - version avec strings"
  (let ((skip-label (gen-label-simplified "UNLESS_SKIP")))
    (append
     (compile-expr-with-ids condition env)
     (list (list :BNE *reg-v0* *reg-zero* skip-label))
     (compile-progn-simplified body env)
     (list (list :LABEL skip-label)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 7. COMPILE-NOT - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-not-simplified (expr env)
  "Compile (NOT expr) - version avec strings"
  (let ((true-label (gen-label-simplified "NOT_TRUE"))
        (end-label (gen-label-simplified "NOT_END")))
    (append
     (compile-expr-with-ids expr env)
     (list (list :BNE *reg-v0* *reg-zero* true-label))
     ;; expr est faux → NOT est vrai
     (list (list :LI *reg-v0* 1)
           (list :J end-label))
     (list (list :LABEL true-label))
     ;; expr est vrai → NOT est faux
     (list (list :LI *reg-v0* 0))
     (list (list :LABEL end-label)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 8. COMPILE-AND - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-and-simplified (exprs env)
  "Compile (AND ...) - version avec strings"
  (if (null exprs)
      (list (list :LI *reg-v0* 1))  ; AND sans args = T
      (if (null (rest exprs))
          ;; Une seule expression
          (compile-expr-with-ids (first exprs) env)
          ;; Multiple expressions
          (let ((false-label (gen-label-simplified "AND_FALSE"))
                (end-label (gen-label-simplified "AND_END")))
            (append
             (compile-expr-with-ids (first exprs) env)
             (list (list :BEQ *reg-v0* *reg-zero* false-label))
             (compile-and-simplified (rest exprs) env)
             (list (list :J end-label))
             (list (list :LABEL false-label))
             (list (list :LI *reg-v0* 0))
             (list (list :LABEL end-label)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 9. COMPILE-OR - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-or-simplified (exprs env)
  "Compile (OR ...) - version avec strings"
  (if (null exprs)
      (list (list :LI *reg-v0* 0))  ; OR sans args = NIL
      (if (null (rest exprs))
          ;; Une seule expression
          (compile-expr-with-ids (first exprs) env)
          ;; Multiple expressions
          (let ((true-label (gen-label-simplified "OR_TRUE"))
                (end-label (gen-label-simplified "OR_END")))
            (append
             (compile-expr-with-ids (first exprs) env)
             (list (list :BNE *reg-v0* *reg-zero* true-label))
             (compile-or-simplified (rest exprs) env)
             (list (list :J end-label))
             (list (list :LABEL true-label))
             (list (list :LI *reg-v0* 1))
             (list (list :LABEL end-label)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 10. ALLOC-STACK-SLOT - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; ORIGINAL (non compilable):
;; (setf (compiler-env-stack-offset env) ...)
;;
;; PROBLÈME: SETF sur accesseur non supporté
;;

(defun get-env-stack-offset (env)
  "Récupère l'offset de pile d'un environnement"
  (if (null env)
      0
      (let ((offset-pair (assoc 'stack-offset env)))
        (if offset-pair
            (cdr offset-pair)
            0))))

(defun set-env-stack-offset (env new-offset)
  "Modifie l'offset de pile d'un environnement - version sans SETF"
  ;; Retourne un nouvel environnement avec l'offset mis à jour
  (if (null env)
      (list (cons 'stack-offset new-offset))
      (let ((offset-pair (assoc 'stack-offset env)))
        (if offset-pair
            ;; Remplacer l'entrée existante
            (cons (cons 'stack-offset new-offset)
                  (remove-if (lambda (pair) 
                               (if (listp pair)
                                   (= (car pair) 'stack-offset)
                                   nil))
                             env))
            ;; Ajouter une nouvelle entrée
            (cons (cons 'stack-offset new-offset) env)))))

(defun alloc-stack-slot-simplified (env)
  "Alloue un slot sur la pile - version sans SETF"
  (let* ((current-offset (get-env-stack-offset env))
         (new-offset (- current-offset 4))
         (new-env (set-env-stack-offset env new-offset)))
    (values new-offset new-env)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 11. FREE-VARIABLES - Version simplifiée (sans EQ)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; ORIGINAL: Utilise EQ pour comparer symboles
;; SOLUTION: Utiliser = avec IDs de symboles
;;

(defun is-built-in-operator-simplified (op)
  "Teste si op est un opérateur built-in - version simplifiée"
  (let ((op-id (if (numberp op) op (get-symbol-id op))))
    (if (= op-id *plus-id*) 1
        (if (= op-id *minus-id*) 1
            (if (= op-id *times-id*) 1
                (if (= op-id *div-id*) 1
                    (if (= op-id *if-id*) 1
                        (if (= op-id *let-id*) 1
                            (if (= op-id *defun-id*) 1
                                0)))))))))

(defun free-variables-simplified (expr bound-vars)
  "Trouve les variables libres - version simplifiée sans EQ"
  (if (numberp expr)
      nil  ; Nombre : pas de variables
      (if (symbolp expr)
          ;; Symbole : vérifier si lié
          (if (member-simplified expr bound-vars)
              nil
              (list expr))
          ;; Liste : traiter récursivement
          (if (null expr)
              nil
              (let ((first-elem (first expr)))
                (if (is-built-in-operator-simplified first-elem)
                    ;; Opérateur built-in : traiter les arguments
                    (free-variables-list-simplified (rest expr) bound-vars)
                    ;; Appel de fonction : traiter tout
                    (free-variables-list-simplified expr bound-vars)))))))

(defun member-simplified (item list)
  "Teste si item est dans list - version sans EQ"
  (if (null list)
      nil
      (if (= item (first list))
          1
          (member-simplified item (rest list)))))

(defun free-variables-list-simplified (exprs bound-vars)
  "Trouve les variables libres dans une liste - sans EQ"
  (if (null exprs)
      nil
      (append-two-lists
       (free-variables-simplified (first exprs) bound-vars)
       (free-variables-list-simplified (rest exprs) bound-vars))))

(defun append-two-lists (list1 list2)
  "Concatène deux listes - version récursive sans APPEND"
  (if (null list1)
      list2
      (cons (first list1)
            (append-two-lists (rest list1) list2))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 12. COMPILE-CONSTANT - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-constant-simplified (value env)
  "Compile une constante - version simplifiée"
  (if (numberp value)
      ;; Nombre : charger directement
      (list (list :LI *reg-v0* value))
      ;; Autre type : pour l'instant retourner 0
      ;; (Dans une vraie implémentation, gérer symboles, strings, etc.)
      (list (list :LI *reg-v0* 0))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 13. COMPILE-VARIABLE - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun lookup-variable-in-env (var env)
  "Cherche une variable dans l'environnement - version simplifiée"
  (if (null env)
      nil
      (let ((binding (assoc var (cdr (assoc 'bindings env)))))
        (if binding
            (cdr binding)  ; Retourne l'offset ou la valeur
            (lookup-variable-in-env var (cdr (assoc 'parent env)))))))

(defun compile-variable-simplified (var env)
  "Compile une référence de variable - version simplifiée"
  (let ((location (lookup-variable-in-env var env)))
    (if location
        ;; Variable trouvée : charger depuis la pile
        (list (list :LW *reg-v0* *reg-fp* location))
        ;; Variable non trouvée : retourner 0 (ou erreur)
        (list (list :LI *reg-v0* 0)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; 14. COMPILE-LET - Version simplifiée
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun compile-let-bindings-simplified (bindings env)
  "Compile les bindings d'un LET - version simplifiée"
  (if (null bindings)
      (values nil env)
      (let* ((binding (first bindings))
             (var (first binding))
             (value-expr (second binding))
             ;; Compiler la valeur
             (value-code (compile-expr-with-ids value-expr env))
             ;; Allouer un slot sur la pile
             (offset (- (get-env-stack-offset env) 4))
             (new-env (set-env-stack-offset env offset))
             ;; Ajouter le binding à l'environnement
             (bindings-list (cdr (assoc 'bindings new-env)))
             (updated-bindings (cons (cons var offset) bindings-list))
             (env-with-binding (cons (cons 'bindings updated-bindings) new-env)))
        (multiple-value-bind (rest-code final-env)
            (compile-let-bindings-simplified (rest bindings) env-with-binding)
          (values
           (append value-code
                   (list (list :SW *reg-v0* *reg-sp* 0)
                         (list :ADDI *reg-sp* *reg-sp* -4))
                   rest-code)
           final-env)))))

(defun compile-let-simplified (bindings body env)
  "Compile (LET ...) - version simplifiée"
  (multiple-value-bind (bindings-code new-env)
      (compile-let-bindings-simplified bindings env)
    (let ((body-code (compile-progn-simplified body new-env))
          (cleanup-size (* (length bindings) 4)))
      (append bindings-code
              body-code
              (list (list :ADDI *reg-sp* *reg-sp* cleanup-size))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; INITIALISATION
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(format t "  Versions simplifiées chargées:~%")
(format t "    - gen-label-simplified~%")
(format t "    - compile-if-simplified~%")
(format t "    - compile-cond-simplified~%")
(format t "    - compile-when/unless/not-simplified~%")
(format t "    - compile-and/or-simplified~%")
(format t "    - alloc-stack-slot-simplified~%")
(format t "    - free-variables-simplified~%")
(format t "    - compile-constant/variable-simplified~%")
(format t "    - compile-let-simplified~%")
(format t "~%  Ces fonctions n'utilisent que des constructions compilables!~%~%")
